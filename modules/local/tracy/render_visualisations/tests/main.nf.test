nextflow_process {

    name "Test Process TRACY_RENDER_VISUALISATIONS"
    script "modules/local/tracy/render_visualisations/main.nf"
    process "TRACY_RENDER_VISUALISATIONS"

    tag "modules"
    tag "tracy"

    setup {
        run("PREPARE_INPUTS") {
            script "modules/local/prepare/inputs/main.nf"
            process {
                """
                input[0] = file("${projectDir}/data/test_data_1/samplesheet_test_data_1_multi_ref_grouping_2samples.csv")
                input[1] = file("${projectDir}/data/test_data_1/references.fa")
                input[2] = file("${projectDir}/data/test_data_1", type: 'dir')
                """
            }
        }

        run("TRACY_ALIGN") {
            script "modules/local/tracy/align/main.nf"
            process {
                """
                input[0] = PREPARE_INPUTS.out.reference_files.map { ref ->
                    tuple('sample_1', file("${projectDir}/data/test_data_1/sample_1.abi"), ref)
                }
                """
            }
        }

        run("TRACY_ASSEMBLE") {
            script "modules/local/tracy/assemble/main.nf"
            process {
                """
                input[0] = PREPARE_INPUTS.out.reference_files.map { ref ->
                    tuple(
                        '1',
                        'sample_1_sample_2',
                        ref,
                        [
                            file("${projectDir}/data/test_data_1/sample_1.abi"),
                            file("${projectDir}/data/test_data_1/sample_2.abi")
                        ]
                    )
                }
                """
            }
        }
    }

    test("Should render an HTML viewer from a tracy align JSON") {

        when {
            params {
                data_dir = "${projectDir}/data/test_data_1"
            }
            process {
                """
                input[0] = TRACY_ALIGN.out.json_results.map { sample_id, json ->
                    tuple(sample_id, 'align', json)
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.html_viewer.size() == 1 },
                { assert process.out.html_viewer.get(0).get(0) == 'align' },
                { assert process.out.html_viewer.get(0).get(1).endsWith("sample_1.html") },
                { assert path(process.out.html_viewer.get(0).get(1)).exists() }
            )
        }
    }

    test("Should render an alignment browser from a tracy assemble multi-FASTA") {

        when {
            params {
                data_dir = "${projectDir}/data/test_data_1"
            }
            process {
                """
                input[0] = TRACY_ASSEMBLE.out.assemble_results
                    .flatMap { grp, files -> (files instanceof List) ? files : [files] }
                    .filter { f -> f.name.endsWith('.align.fa') }
                    .map { align_fasta -> tuple('sample_1_sample_2_alignment', 'assemble', align_fasta) }
                """
            }
        }

        then {
            def viewer = process.out.html_viewer.get(0).get(1)
            assertAll(
                { assert process.success },
                { assert process.out.html_viewer.size() == 1 },
                { assert process.out.html_viewer.get(0).get(0) == 'assemble' },
                { assert viewer.endsWith("sample_1_sample_2_alignment.html") },
                // tracy-vis picks the viewer from the file's content, so the
                // multi-FASTA renders as Sabre's alignment browser rather than
                // one of the JSON trace viewers.
                { assert path(viewer).text.contains('Alignment Browser') }
            )
        }
    }

    test("Should render an assembly editor from a tracy assemble JSON") {

        when {
            params {
                data_dir = "${projectDir}/data/test_data_1"
            }
            process {
                """
                input[0] = TRACY_ASSEMBLE.out.assemble_results
                    .flatMap { grp, files -> (files instanceof List) ? files : [files] }
                    .filter { f -> f.name.endsWith('.json') }
                    .map { json_file -> tuple(json_file.baseName, 'assemble', json_file) }
                """
            }
        }

        then {
            def viewer = process.out.html_viewer.get(0).get(1)
            assertAll(
                { assert process.success },
                { assert process.out.html_viewer.size() == 1 },
                { assert process.out.html_viewer.get(0).get(0) == 'assemble' },
                { assert viewer.endsWith("sample_1_sample_2.html") },
                // The same JSON's `gappedTraces` make it an assembly, so it
                // renders as Pearl's editable assembly rather than a single
                // trace view.
                { assert path(viewer).text.contains('Assembly Editor') }
            )
        }
    }
}
