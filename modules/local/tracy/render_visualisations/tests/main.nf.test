nextflow_process {

    name "Test Process TRACY_RENDER_VISUALISATIONS"
    script "modules/local/tracy/render_visualisations/main.nf"
    process "TRACY_RENDER_VISUALISATIONS"

    tag "modules"
    tag "tracy"

    setup {
        run("PREPARE_INPUTS") {
            script "modules/local/prepare/inputs/main.nf"
            process {
                """
                input[0] = file("${projectDir}/data/test_data_1/samplesheet_test_data_1_multi_ref_grouping_2samples.csv")
                input[1] = file("${projectDir}/data/test_data_1/references.fa")
                input[2] = file("${projectDir}/data/test_data_1", type: 'dir')
                """
            }
        }

        run("TRACY_ASSEMBLE") {
            script "modules/local/tracy/assemble/main.nf"
            process {
                """
                input[0] = PREPARE_INPUTS.out.reference_files.map { ref ->
                    tuple(
                        '1',
                        'sample_1_sample_2',
                        ref,
                        [
                            file("${projectDir}/data/test_data_1/sample_1.abi"),
                            file("${projectDir}/data/test_data_1/sample_2.abi")
                        ]
                    )
                }
                """
            }
        }

        run("TRACY_ALIGN") {
            script "modules/local/tracy/align/main.nf"
            process {
                """
                input[0] = PREPARE_INPUTS.out.reference_files.map { ref ->
                    tuple('sample_1', file("${projectDir}/data/test_data_1/sample_1.abi"), ref)
                }
                """
            }
        }
    }

    test("Should render an HTML viewer from an assembly alignment FASTA") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        'sample_1_sample_2.msa',
                        'assemble',
                        file("${projectDir}/data/test_data_1/assembly_group_1.align.fa")
                    )
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.html_viewer.size() == 1 },
                { assert process.out.html_viewer.get(0).get(0) == 'assemble' },
                { assert process.out.html_viewer.get(0).get(1).endsWith("sample_1_sample_2.msa.html") },
                { assert path(process.out.html_viewer.get(0).get(1)).exists() },
                { assert path(process.out.html_viewer.get(0).get(1)).text.contains('sabre-msa-view') }
            )
        }
    }

    test("Should render an HTML viewer from a tracy align JSON") {

        when {
            params {
                data_dir = "${projectDir}/data/test_data_1"
            }
            process {
                """
                input[0] = TRACY_ALIGN.out.json_results.map { sample_id, json ->
                    tuple(sample_id, 'align', json)
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.html_viewer.size() == 1 },
                { assert process.out.html_viewer.get(0).get(0) == 'align' },
                { assert process.out.html_viewer.get(0).get(1).endsWith("sample_1.html") },
                { assert path(process.out.html_viewer.get(0).get(1)).exists() }
            )
        }
    }

    test("Should render a pearl assembly editor from a tracy assemble JSON") {

        when {
            params {
                data_dir = "${projectDir}/data/test_data_1"
            }
            process {
                """
                input[0] = TRACY_ASSEMBLE.out.assembly_json.map { group_id, json ->
                    tuple(group_id + '.assembly', 'assemble', json)
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.html_viewer.size() == 1 },
                { assert process.out.html_viewer.get(0).get(0) == 'assemble' },
                { assert process.out.html_viewer.get(0).get(1).endsWith("sample_1_sample_2.assembly.html") },
                { assert path(process.out.html_viewer.get(0).get(1)).exists() },
                { assert path(process.out.html_viewer.get(0).get(1)).text.contains('pearl-assembly-view') }
            )
        }
    }
}
