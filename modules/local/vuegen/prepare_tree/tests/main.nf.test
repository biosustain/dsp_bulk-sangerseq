nextflow_process {

    name "Test Process VUEGEN_PREPARE_TREE"
    script "modules/local/vuegen/prepare_tree/main.nf"
    process "VUEGEN_PREPARE_TREE"

    tag "modules"
    tag "vuegen"

    setup {
        run("PREPARE_INPUTS") {
            script "modules/local/prepare/inputs/main.nf"
            process {
                """
                input[0] = file("${projectDir}/data/test_data_1/samplesheet_test_data_1_multi_ref_grouping_2samples.csv")
                input[1] = file("${projectDir}/data/test_data_1/references.fa")
                input[2] = file("${projectDir}/data/test_data_1", type: 'dir')
                """
            }
        }

        run("TRACY_DECOMPOSE") {
            script "modules/local/tracy/decompose/main.nf"
            process {
                """
                input[0] = PREPARE_INPUTS.out.reference_files.flatMap { ref ->
                    [
                        tuple('sample_1', file("${projectDir}/data/test_data_1/sample_1.abi"), ref),
                        tuple('sample_2', file("${projectDir}/data/test_data_1/sample_2.abi"), ref)
                    ]
                }
                """
            }
        }

        run("TRACY_ALIGN") {
            script "modules/local/tracy/align/main.nf"
            process {
                """
                input[0] = PREPARE_INPUTS.out.reference_files.flatMap { ref ->
                    [
                        tuple('sample_1', file("${projectDir}/data/test_data_1/sample_1.abi"), ref),
                        tuple('sample_2', file("${projectDir}/data/test_data_1/sample_2.abi"), ref)
                    ]
                }
                """
            }
        }

        run("TRACY_ASSEMBLE") {
            script "modules/local/tracy/assemble/main.nf"
            process {
                """
                input[0] = PREPARE_INPUTS.out.reference_files.map { ref ->
                    tuple(
                        '1',
                        'sample_1_sample_2',
                        ref,
                        [
                            file("${projectDir}/data/test_data_1/sample_1.abi"),
                            file("${projectDir}/data/test_data_1/sample_2.abi")
                        ]
                    )
                }
                """
            }
        }

        run("TRACY_RENDER_VISUALISATIONS", alias: "TRACY_RENDER_DECOMPOSE") {
            script "modules/local/tracy/render_visualisations/main.nf"
            process {
                """
                input[0] = TRACY_DECOMPOSE.out.json_results
                    .map { sample_id, json -> tuple(sample_id, 'decompose', json) }
                """
            }
        }

        run("TRACY_RENDER_VISUALISATIONS", alias: "TRACY_RENDER_ALIGN") {
            script "modules/local/tracy/render_visualisations/main.nf"
            process {
                """
                input[0] = TRACY_ALIGN.out.json_results
                    .map { sample_id, json -> tuple(sample_id, 'align', json) }
                """
            }
        }

        run("TRACY_RENDER_VISUALISATIONS", alias: "TRACY_RENDER_ASSEMBLE") {
            script "modules/local/tracy/render_visualisations/main.nf"
            process {
                """
                input[0] = TRACY_ASSEMBLE.out.assemble_results
                    .flatMap { grp, files -> (files instanceof List) ? files : [files] }
                    .filter { f -> f.name.endsWith('.json') }
                    .map { json -> tuple(json.baseName, 'assemble', json) }
                """
            }
        }

        run("TRACY_RENDER_VISUALISATIONS", alias: "TRACY_RENDER_ASSEMBLE_ALIGNMENT") {
            script "modules/local/tracy/render_visualisations/main.nf"
            process {
                """
                input[0] = TRACY_ASSEMBLE.out.assemble_results
                    .flatMap { grp, files -> (files instanceof List) ? files : [files] }
                    .filter { f -> f.name.endsWith('.align.fa') }
                    .map { align_fasta ->
                        tuple((align_fasta.name - '.align.fa') + '_alignment', 'assemble', align_fasta)
                    }
                """
            }
        }

        run("TRACY_DECOMPOSE_POSTPROCESS") {
            script "modules/local/tracy/postprocess/main.nf"
            process {
                """
                input[0] = TRACY_DECOMPOSE.out.json_results
                    .map { sample_id, json -> json }
                    .collect()
                """
            }
        }
    }

    test("Should build the VueGen report tree") {

        when {
            params {
                data_dir = "${projectDir}/data/test_data_1"
            }
            process {
                """
                input[0] = TRACY_DECOMPOSE_POSTPROCESS.out.combined
                input[1] = TRACY_RENDER_DECOMPOSE.out.html_viewer
                    .map { section, html -> html }
                    .collect()
                input[2] = TRACY_RENDER_ALIGN.out.html_viewer
                    .map { section, html -> html }
                    .collect()
                input[3] = TRACY_RENDER_ASSEMBLE.out.html_viewer
                    .mix(TRACY_RENDER_ASSEMBLE_ALIGNMENT.out.html_viewer)
                    .map { section, html -> html }
                    .collect()
                """
            }
        }

        then {
            def tree = process.out.tree.get(0)
            assertAll(
                { assert process.success },
                // The combined mutation table is copied into section 01.
                { assert path("${tree}/01_Mutation_tables_decompose/results_combined.csv").exists() },
                // The rendered viewers stand in for the decompose, align and
                // assemble text reports, kept apart by section so the two
                // `sample_1.html` files do not collide.
                { assert path("${tree}/02_alignments_decompose/sample_1.html").exists() },
                { assert path("${tree}/02_alignments_decompose/sample_2.html").exists() },
                { assert path("${tree}/03_alignments_align/sample_1.html").exists() },
                { assert path("${tree}/03_alignments_align/sample_2.html").exists() },
                { assert path("${tree}/04_sequence_assembly_assemble/sample_1_sample_2.html").exists() },
                // The assembly section carries both of the group's viewers:
                // Pearl's consensus assembly and Sabre's read-by-read alignment.
                { assert path("${tree}/04_sequence_assembly_assemble/sample_1_sample_2_alignment.html").exists() },
                // The assembly text tracy wrote is not printed a second time
                // as fenced-code markdown beside the viewer.
                { assert !path("${tree}/04_sequence_assembly_assemble/consensus_sequences").exists() }
            )
        }
    }
}
