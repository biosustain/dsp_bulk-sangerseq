params {
    // `outdir` has no default: it is a required parameter (see nextflow_schema.json).
    // Provide it via `--outdir <dir>` or a profile (e.g. `-profile test`).
    outdir                   = null
    publish_dir_mode         = 'copy'

    // Input data (samplesheet, reference_fasta, data_dir) is not defaulted here;
    // provide it via -profile test or on the command line.

    trim_left                = 50
    trim_right               = 50
    trim_stringency_decompose = 0
    trim_stringency_align    = 0
    trim_stringency_assemble = 4

    tracy_image              = 'geargenomics/tracy:v0.8.9'
    // Bundles Tracy JSON outputs into self-contained HTML viewers (auto-detects
    // trace vs indigo visualisation type). See github.com/biosustain/tracy-visualisations.
    visualisation_image      = 'ghcr.io/biosustain/tracy-visualisations:latest'
    container_platform       = 'linux/amd64'

    // VueGen report, rendered by the nf-core VUEGEN module (modules/nf-core/vuegen),
    // which ships its own maintained container with vuegen and its report-type
    // dependencies (e.g. quarto-cli) baked in.
    vuegen_report_type       = 'html'
}

process {
    errorStrategy            = 'terminate'
    cpus                     = 1
    memory                   = '4 GB'
    time                     = '4h'
}

docker {
    enabled                  = false
    runOptions               = '--platform linux/amd64'
}
