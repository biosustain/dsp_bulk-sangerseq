includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/reporting.config'

// Stage bin scripts only into the module that declares them (as
// resources/usr/bin/), instead of copying the whole top-level bin/ into
// every task via a bundled (glibc) azcopy binary. Without this, Azure
// Batch stages the pipeline bin/ folder into every container, which fails
// on musl/Alpine images like geargenomics/tracy that never call any bin/
// script in the first place. Requires Wave (enabled at the compute-env
// level) since the work directory is remote (az://) object storage.
nextflow.enable.moduleBinaries = true

params {
    custom_config_version = 'master'
    custom_config_base = "https://raw.githubusercontent.com/biosustain/configs/${params.custom_config_version}"
}


profiles {
    test {
        includeConfig 'conf/test.config'
    }

    docker {
        docker.enabled = true
        singularity.enabled = false
        wave.enabled = false
    }
}

manifest {
    name = 'biosustain/dsp_bulk-sangerseq'
    author = 'biosustain'
    homePage = 'https://github.com/biosustain/dsp_bulk-sangerseq'
    description = 'Nextflow pipeline for bulk Sanger sequencing analysis using Tracy'
    mainScript = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version = '1.1.0-dev'
    defaultBranch = 'main'
}
