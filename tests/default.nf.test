nextflow_pipeline {
  name "default"
  script "main.nf"
  config "tests/nextflow.config"

  test("default") {
    when {
      params {
        outdir = "$outputDir"
      }
    }
    then {
      // Null-safe, so a missing `assemble` directory fails the assertion below
      // rather than throwing out of it.
      def assembleFiles = new File("${outputDir}/assemble").listFiles() ?: []

      assertAll(
        { assert workflow.success },
        { assert workflow.trace.tasks().size() > 0 },
        { assert path("${outputDir}/align").exists() },
        // Every assembly group gets two viewers: pearl's editable assembly as
        // `<group>.html` and sabre's multiple-sequence alignment as
        // `<group>_alignment.html`.
        { assert assembleFiles.any { it.name.endsWith('_alignment.html') } },
        { assert assembleFiles.any { it.name.endsWith('.html') && !it.name.endsWith('_alignment.html') } }
      )
    }
  }
}
