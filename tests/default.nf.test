nextflow_pipeline {
  name "default"
  script "main.nf"
  config "tests/nextflow.config"

  test("default") {
    when {
      params {
        outdir = "$outputDir"
      }
    }
    then {
      assertAll(
        { assert workflow.success },
        { assert workflow.trace.tasks().size() > 0 },
        { assert path("${outputDir}/align").exists() },
        // `tracy assemble` gets two viewers: sabre's multiple-sequence
        // alignment and pearl's editable assembly.
        { assert new File("${outputDir}/assemble").listFiles().any { it.name.endsWith('.msa.html') } },
        { assert new File("${outputDir}/assemble").listFiles().any { it.name.endsWith('.assembly.html') } }
      )
    }
  }
}
